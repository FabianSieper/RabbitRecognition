# RabbitRecognition environment overrides.
#
# Precedence: environment variables (this file) > config.toml > built-in
# defaults. The config file (config.toml, or the path in RABBIT_CONFIG) is
# the place for stable settings; use this file for overrides.
# All variables are optional.

# Path to an alternate config file (.toml or .json).
RABBIT_CONFIG=""

# Base URL of the Hasen-Stream backend on the camera Pi (same LAN).
# Port 8000 hits the FastAPI backend directly; port 3000 is the nginx
# front. Both expose GET /mjpeg and POST /image/save.
HASEN_STREAM_URL="http://192.168.178.135:8000"

# Frame source endpoint: "mjpeg" (default) or "save".
RABBIT_STREAM_METHOD=""

# Timeout in seconds for fetching one frame from the stream.
RABBIT_STREAM_TIMEOUT="20"

# Path to the ONNX model (default: models/mobilenet_v2_rabbit.onnx).
RABBIT_MODEL=""

# Rabbit probability threshold (empty = model default 0.5 from models/manifest.json).
RABBIT_THRESHOLD=""

# ONNX Runtime intra-op threads (2 is a good default on a Pi).
RABBIT_NUM_THREADS="2"

# HTTP API bind address + port (n8n on the same Pi calls /recognize here).
RABBIT_HOST="0.0.0.0"
RABBIT_PORT="8011"

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
RABBIT_LOG_LEVEL="INFO"

# Include the base64-encoded frame in the /recognize payload (1/true or 0/false).
RABBIT_INCLUDE_IMAGE="true"
