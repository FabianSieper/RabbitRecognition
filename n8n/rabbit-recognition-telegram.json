      "id": "b7e1f2a3-0004-4c5d-9e6f-2a3b4c5d6e7f",
      "name": "Bild aus Base64",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        100,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\n\n// Wenn /stop gesetzt wurde, hier beenden.\n// Standardmäßig ist der Versand aktiv.\nif (state.telegramPaused === true) {\n  return [];\n}\n\nconst item = $input.first();\nconst binary = item.binary ?? {};\nconst image = binary.image ?? binary.data ?? Object.values(binary)[0];\n\nif (!image) {\n  throw new Error('Kein Bild vorhanden');\n}\n\nreturn [\n  {\n    binary: {\n      image\n    }\n  }\n];"
      },
      "id": "b7e1f2a3-0005-4c5d-9e6f-2a3b4c5d6e7f",
