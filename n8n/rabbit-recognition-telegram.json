      "id": "8db4bfbe-0827-4def-a71e-8d6d4ed4d3a7",
      "name": "Telegram Kommandos",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        360
      ],
      "webhookId": "5c6d7e8f-0a1b-4c2d-9e3f-4a5b6c7d8e9f",
      "credentials": {
        "telegramApi": {
          "id": "hrff9SdHTUZYVcup",
          "name": "Hasi"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst message = input.message ?? {};\nconst chatId = String(message.chat?.id ?? '');\nconst rawText = String(message.text ?? '').trim();\nconst command = (rawText.split(/\\s+/)[0] ?? '').toLowerCase().split('@')[0];\n\nif (!chatId) return [];\n\nconst ALLOWED = ['632078830'];\n\nif (command === '/chatid') {\n  return [{ json: { chatId, text: chatId, command, route: 0 } }];\n}\n\nif (ALLOWED.length && !ALLOWED.includes(chatId)) {\n  return [{ json: { chatId, command, route: 1, text: 'Deine Telegram-ID ist nicht freigeschaltet. Nutze /chatId, um deine ID zu erhalten, und lass sie im n8n Flow freischalten.' } }];\n}\n\nif (command === '') return [];\n\nif (command === '/hilfe') {\n  return [{ json: {\n    chatId,\n    command,\n    route: 0,\n    text: 'Befehle:\\n/start – Fotos an\\n/stop – Fotos aus\\n/status – aktueller Status\\n/chatid – deine Telegram-ID anzeigen',\n  } }];\n}\n\nif (command === '/start') return [{ json: { chatId, command, images: true, route: 2 } }];\nif (command === '/stop') return [{ json: { chatId, command, images: false, route: 3 } }];\nif (command === '/status') return [{ json: { chatId, command, route: 4 } }];\n\nreturn [{ json: { chatId, command, route: 5, text: 'Unbekannter Befehl. Nutze /hilfe, /start, /stop, /status oder /chatId.' } }];"
      },
