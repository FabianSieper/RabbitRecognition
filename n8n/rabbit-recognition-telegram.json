    {
      "parameters": {
        "jsCode": "const time = new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC';\nreturn $input.all()\n  .filter((item) => (item.json.images === true || item.json.images === 'true') && item.binary?.image)\n  .map((item) => ({\n    json: {\n      chatId: String(item.json.chatId ?? ''),\n      time,\n    },\n    binary: { image: item.binary.image },\n  }));"
      },
