      "id": "b7e1f2a3-0008-4c5d-9e6f-2a3b4c5d6e7f",
      "name": "Telegram Kommandos",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -560,
        320
      ],
      "webhookId": "5c6d7e8f-0a1b-4c2d-9e3f-4a5b6c7d8e9f",
      "credentials": {
        "telegramApi": {
          "id": "hrff9SdHTUZYVcup",
          "name": "Hasi"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst message = input.message ?? {};\n\nconst chatId = String(message.chat?.id ?? '');\nconst userId = String(message.from?.id ?? '');\n\n// Sicherheit: Nur dein eigener Telegram-Account darf steuern.\nif (chatId !== '632078830' || userId !== '632078830') {\n  return [];\n}\n\nconst text = String(message.text ?? '').trim();\nconst firstToken = text.split(/\\s+/)[0] ?? '';\nconst command = firstToken.toLowerCase().split('@')[0];\n\nconst state = $getWorkflowStaticData('global');\n\n// Default: Benachrichtigungen sind aktiv\nconst isPaused = state.telegramPaused === true;\n\nif (command === '/stop') {\n  state.telegramPaused = true;\n\n  return [\n    {\n      json: {\n        chatId,\n        text: '⏸ Bildbenachrichtigungen sind pausiert. Mit /start wieder aktivieren.'\n      }\n    }\n  ];\n}\n\nif (command === '/start') {\n  state.telegramPaused = false;\n\n  return [\n    {\n      json: {\n        chatId,\n        text: '▶️ Bildbenachrichtigungen sind aktiviert.'\n      }\n    }\n  ];\n}\n\nif (command === '/status') {\n  return [\n    {\n      json: {\n        chatId,\n        text: isPaused\n          ? '⏸ Status: Bildbenachrichtigungen sind pausiert.'\n          : '▶️ Status: Bildbenachrichtigungen sind aktiviert.'\n      }\n    }\n  ];\n}\n\nreturn [];"
      },
      "id": "b7e1f2a3-0009-4c5d-9e6f-2a3b4c5d6e7f",
      "name": "Start Stop verarbeiten",
