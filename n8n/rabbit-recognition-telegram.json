    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst chatId = String(item.chatId ?? '');\nconst hasRow = 'images' in item || 'updatedAt' in item;\nconst images = item.images === true || item.images === 'true';\nlet text;\nif (!hasRow) {\n  text = 'Für ' + chatId + ' ist noch nichts gespeichert. Nutze /start oder /stop.';\n} else if (images) {\n  text = '📷 Bilder an: Ich schicke dir Bilder, wenn ein Hase entdeckt wird.';\n} else {\n  text = '⏸ Bilder aus: Ich schicke dir nichts.';\n}\nreturn [{ json: { chatId, text } }];"
      },
