      "id": "b7e1f2a3-0010-4c5d-9e6f-2a3b4c5d6e7f",
      "name": "Status anzeigen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst chatId = String(item.chatId ?? '');\nconst hasRow = 'images' in item || 'updatedAt' in item;\nconst images = item.images === true || item.images === 'true';\nlet text;\nif (!hasRow) {\n  text = 'Für ' + chatId + ' ist noch nichts gespeichert. Nutze /start oder /stop.';\n} else if (images) {\n  text = '📷 Bilder an: Ich schicke dir Bilder, wenn ein Hase entdeckt wird.' + (item.updatedAt ? '\\nGeändert: ' + item.updatedAt : '');\n} else {\n  text = '⏸ Bilder aus: Ich schicke dir nichts.' + (item.updatedAt ? '\\nGeändert: ' + item.updatedAt : '');\n}\nreturn [{ json: { chatId, text } }];"
      }
    },
