    {
      "parameters": {
        "jsCode": "// Hier die Telegram-Chat-IDs eintragen, die den Bot nutzen dürfen.\nconst allowedChatIds = ['632078830'];\n\nconst input = $input.first().json;\nconst message = input.message ?? {};\nconst chatId = String(message.chat?.id ?? '');\n\nreturn [{\n  json: {\n    chatId,\n    message,\n    isAllowed: allowedChatIds.length > 0 ? allowedChatIds.includes(chatId) : true,\n  },\n}];"
      },
      "id": "c7833d35-5d44-4f34-b2d9-65bc3705371e",
      "name": "Zugriff prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        3488
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst message = input.message ?? {};\nconst chatId = String(input.chatId ?? '');\nconst rawText = String(message.text ?? '').trim();\nconst command = (rawText.split(/\\s+/)[0] ?? '').toLowerCase().split('@')[0];\n\nif (!chatId) return [];\n\nif (command === '/chatid') {\n  return [{ json: { chatId, text: chatId, command, route: 0 } }];\n}\n\nif (!input.isAllowed) {\n  return [{ json: { chatId, command, route: 1, text: 'Deine Telegram-ID ist nicht freigeschaltet. Nutze /chatid, um deine ID zu erhalten, und lass sie im n8n Flow freischalten.' } }];\n}\n\nif (command === '') return [];\n\nif (command === '/hilfe') {\n  return [{ json: {\n    chatId,\n    command,\n    route: 0,\n    text: 'Befehle:\\n/start – Fotos an\\n/stop – Fotos aus\\n/status – aktueller Status\\n/chatid – deine Telegram-ID anzeigen',\n  } }];\n}\n\nif (command === '/start') return [{ json: { chatId, command, images: true, route: 2 } }];\nif (command === '/stop') return [{ json: { chatId, command, images: false, route: 3 } }];\nif (command === '/status') return [{ json: { chatId, command, route: 4 } }];\n\nreturn [{ json: { chatId, command, route: 5, text: 'Unbekannter Befehl. Nutze /hilfe, /start, /stop, /status oder /chatid.' } }];"
      },
