      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-rabbit",
              "leftValue": "={{ $json.rabbit }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "logic": "and"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
