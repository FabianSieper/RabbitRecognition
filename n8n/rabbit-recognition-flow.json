    {
      "parameters": {},
      "id": "1780E70C-59D9-4BFE-A82D-5E03DA379B56",
      "name": "No rabbit",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 120]
    }
  ],
