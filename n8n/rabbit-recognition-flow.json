        "fileNameSuffix": "=rabbit_{{ $now.toFormat('yyyyMMdd_HHmmssSSS') }}.jpg",
        "options": {
          "append": false,
          "dataPropertyName": "data"
        }
      },
      "id": "5954A7C7-EB5D-4BB4-9BC2-9DC714B44806",
      "name": "Save rabbit frame",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [880, -120]
